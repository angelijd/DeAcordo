# Tokens de autenticação do Slack (Socket Mode)
SLACK_APP_TOKEN=xapp-sua-chave-aqui
SLACK_BOT_TOKEN=xoxb-sua-chave-aqui

# Canal onde os tickets/cards de aprovação serão postados
SLACK_CHANNEL_ID=C0C39TC11RC

# Canais Slack de origem usados para detectar automaticamente o tipo de
# solicitação (Crescimento ou Renovação) quando o /solicitacao ou o botão
# fixo são usados a partir deles. Se o canal de origem não estiver aqui, o
# modal pede que o consultor escolha o tipo manualmente.
CHANNEL_ID_CRESCIMENTO=
CHANNEL_ID_RENOVACAO=

# Pasta onde tickets_state.json e substitutions_state.json são gravados.
# Deixe em branco para usar a pasta do projeto (padrão). Em hospedagens com
# disco efêmero (ex.: Railway sem Volume), configure para um caminho montado
# num Volume persistente, senão o estado é apagado a cada novo deploy.
DATA_DIR=

# Aprovador N3 da Renovação (definido pela Frente CSE/CSP + Marca, em config/n3_config.py).
# false = no teste, só cita o nome do N3 no post (não marca no Slack nem manda DM pra ele).
# true  = marca o N3 de verdade e manda a DM de aprovação.
N3_MARCAR_APROVADORES=false

# Exceções cuja regra é "N3 - Chalfun/Faleiros":
# true  = modo alta demanda: vão para o N3 de cada marca (tabela de N3, só na Renovação).
# false = vão para os diretores Chalfun e Faleiros; qualquer um dos dois decide.
MODO_ALTA_DEMANDA=false

# Espelhamento dos tickets numa planilha do Google (opcional; vazio = desligado).
# GOOGLE_SHEET_ID é o código entre /d/ e /edit no link da planilha.
# O arquivo da conta de serviço fica na pasta do projeto e NUNCA vai pro Git.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# IDs de Slack (separados por vírgula) autorizados a agir como @triagem
# Ex.: TRIAGEM_USER_IDS=U0123456789,U0456789012
TRIAGEM_USER_IDS=

# ⚠️ Use "true" APENAS em desenvolvimento/homologação local.
# Em produção, mantenha "false": "true" libera qualquer usuário do workspace para agir
# como @triagem e para aprovar/reprovar qualquer alçada (modo de teste/mock).
USE_MOCK_USERS=false
TEST_ALLOW_SELF_APPROVAL=false
