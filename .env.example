# Tokens de autenticação do Slack (Socket Mode)
SLACK_APP_TOKEN=xapp-sua-chave-aqui
SLACK_BOT_TOKEN=xoxb-sua-chave-aqui

# Canal onde os tickets/cards de aprovação serão postados
SLACK_CHANNEL_ID=C0C1W7PF9S7

# IDs de Slack (separados por vírgula) autorizados a agir como @triagem
# Ex.: TRIAGEM_USER_IDS=U0123456789,U0456789012
TRIAGEM_USER_IDS=

# ⚠️ Use "true" APENAS em desenvolvimento/homologação local.
# Em produção, mantenha "false": "true" libera qualquer usuário do workspace para agir
# como @triagem e para aprovar/reprovar qualquer alçada (modo de teste/mock).
USE_MOCK_USERS=false
TEST_ALLOW_SELF_APPROVAL=false
